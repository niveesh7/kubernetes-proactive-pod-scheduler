{
  "name": "Kubernetes Proactive Pod Scheduler (Cloud 4-Node Cluster)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "enableNonRootDocker": "true"
    },
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "version": "latest",
      "minikube": "none",
      "helm": "none"
    }
  },
  "forwardPorts": [8080, 30080],
  "portsAttributes": {
    "8080": {
      "label": "Proactive Scheduler Live Dashboard",
      "onAutoForward": "openBrowser",
      "elevateIfNeeded": false
    },
    "30080": {
      "label": "Target Cloud Microservice",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "bash setup_codespace.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}
